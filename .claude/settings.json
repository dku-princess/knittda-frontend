{
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["."]
    }
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/key.properties)",
      "Edit(**/key.properties)",
      "Read(**/android/local.properties)",
      "Edit(**/android/local.properties)",
      "Read(**/local.properties)",
      "Edit(**/local.properties)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(**/env.dart)",
      "Edit(**/env.dart)",
      "Read(**/env.local)",
      "Edit(**/env.local)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/config/*.json)",
      "Edit(**/config/*.json)",
      "Read(**/GoogleService-Info.plist)",
      "Edit(**/GoogleService-Info.plist)",
      "Read(**/google-services.json)",
      "Edit(**/google-services.json)",
      "Read(**/*-local.xcconfig)",
      "Edit(**/*-local.xcconfig)",
      "Read(**/flutter_export_environment.sh)",
      "Edit(**/flutter_export_environment.sh)"
    ]
  }
}
